generator client {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  password            String
  phone               String?
  role                String              @default("USER") // USER, FACILITY_MEMBER, ADMIN
  isActive            Boolean             @default(true)
  rewardPoints        Int                 @default(0)
  failedLoginAttempts Int                 @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  pickupRequests      PickupRequest[]
  aiScans             AIScan[]
  rewardTransactions  RewardTransaction[]
  reviews             Review[]
  managedFacilities   Facility[]          @relation("FacilityManager")
}

model Facility {
  id                 String          @id @default(uuid())
  name               String
  address            String
  city               String
  state              String
  pincode            String
  latitude           Float
  longitude          Float
  phone              String
  email              String
  website            String?
  openingHours       String          @default("Mon-Sat: 9:00 AM - 6:00 PM")
  acceptedCategories String // Comma-separated list e.g. "Smartphone, Laptop, Battery, Monitor"
  recyclingServices  String          @default("Collection, Segregation, Refurbishing, Material Extraction")
  capacity           String          @default("10,000 kg/month")
  rating             Float           @default(4.8)
  isVerified         Boolean         @default(false)
  verificationStatus String          @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  isActive           Boolean         @default(true)
  managerId          String?
  manager            User?           @relation("FacilityManager", fields: [managerId], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  pickupRequests     PickupRequest[]
  reviews            Review[]
}

model PickupRequest {
  id                String    @id @default(uuid())
  trackingCode      String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId        String?
  facility          Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  name              String
  phone             String
  email             String
  address           String
  city              String
  pincode           String
  category          String
  quantity          Int       @default(1)
  weightKg          Float     @default(1.0)
  preferredDate     String
  preferredTimeSlot String
  notes             String?
  status            String    @default("REQUESTED") // REQUESTED, CONFIRMED, ASSIGNED, PICKED_UP, RECYCLED, COMPLETED
  estimatedPoints   Int       @default(100)
  earnedPoints      Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model AIScan {
  id                  String   @id @default(uuid())
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  imageUrl            String
  detectedItem        String
  category            String
  confidence          Float
  estimatedWeightKg   Float
  estimatedPoints     Int
  recyclableMaterials String // JSON string of material breakdown
  safetyNotes         String
  disposalMethod      String
  isDemoMode          Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model RewardTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points      Int
  type        String   @default("EARNED") // EARNED, REDEEMED
  title       String
  description String
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
}

model RewardCatalog {
  id             String   @id @default(uuid())
  title          String
  description    String
  pointsRequired Int
  category       String
  partnerName    String
  imageUrl       String
  code           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}
